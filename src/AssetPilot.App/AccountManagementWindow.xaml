<Window x:Class="AssetPilot.App.AccountManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:accounts="clr-namespace:AssetPilot.Core.Accounts;assembly=AssetPilot.Core"
        Title="계좌 관리"
        Height="450"
        Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="{StaticResource Padding.Dialog}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0"
                 Style="{StaticResource ListBox.Accounts}"
                 ItemContainerStyle="{StaticResource ListBoxItem.Account}"
                 ItemsSource="{Binding Accounts}"
                 SelectedItem="{Binding SelectedAccount}"
                 DisplayMemberPath="AccountNumber" />

        <Grid Grid.Row="1" Margin="{StaticResource Margin.SectionTop}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="계좌번호" />
            <TextBox Grid.Column="1"
                     Style="{StaticResource TextBox.Standard}"
                     Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="2" Margin="{StaticResource Margin.DialogRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="환경" />
            <ComboBox Grid.Column="1"
                      Style="{StaticResource ComboBox.Account}"
                      SelectedValue="{Binding Environment}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="실전" Tag="{x:Static accounts:KiwoomEnvironment.Real}" />
                <ComboBoxItem Content="모의투자" Tag="{x:Static accounts:KiwoomEnvironment.Mock}" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3" Margin="{StaticResource Margin.DialogRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="App Key" />
            <TextBox Grid.Column="1"
                     Style="{StaticResource TextBox.Standard}"
                     Text="{Binding AppKey, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="4" Margin="{StaticResource Margin.DialogRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Secret Key" />
            <PasswordBox x:Name="SecretKeyPasswordBox"
                         Grid.Column="1"
                         Style="{StaticResource PasswordBox.Standard}" />
        </Grid>

        <TextBlock Grid.Row="5"
                   Margin="{StaticResource Space.12}"
                   Style="{StaticResource Text.ErrorMessage}"
                   Text="{Binding StatusMessage}" />

        <Grid Grid.Row="6" Margin="{StaticResource Margin.SectionTop}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Button.Danger}"
                    HorizontalAlignment="Left"
                    Click="DeleteButton_Click"
                    Content="계좌 삭제" />
            <Button Grid.Column="1"
                    Style="{StaticResource Button.Primary}"
                    Click="SaveButton_Click"
                    Content="저장" />
        </Grid>
    </Grid>
</Window>
