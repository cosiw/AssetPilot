<Window x:Class="AssetPilot.App.BacktestExperimentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:experiments="clr-namespace:AssetPilot.Backtest.Experiments;assembly=AssetPilot.Backtest"
        Title="청산 파라미터 실험" Height="720" Width="1120" MinHeight="540" MinWidth="850"
        Background="{StaticResource Brush.AppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource Padding.Window}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="ATR 청산 파라미터 실험"/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Label}" Text="진입 조건은 고정하고 익절·손절·최대 보유 기간만 비교합니다. 결과는 자동 적용되지 않습니다." TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Row="1" Margin="0,18,0,0" Padding="18" Style="{StaticResource Surface.Ledger}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="일봉 CSV"/>
                        <Grid Margin="0,6,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DailyCsvPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" MinWidth="86" Style="{StaticResource Button.Secondary}" Click="SelectDailyCsvButton_Click" Content="파일 선택"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Label}" Text="5분봉 CSV"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FiveMinuteCsvPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" MinWidth="86" Style="{StaticResource Button.Secondary}" Click="SelectFiveMinuteCsvButton_Click" Content="파일 선택"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="시작 자금"/>
                        <TextBox Margin="0,6,0,12" Text="{Binding StartingCash, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Text.Label}" Text="투자 비율 (%)"/>
                        <TextBox Margin="0,6,0,12" Text="{Binding AllocationPercent, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Text.Label}" Text="CSV 출력 폴더"/>
                        <TextBox Margin="0,6,0,0" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <WrapPanel>
                    <Button Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Command="{Binding RunCommand}" CommandParameter="{x:Static experiments:ExitParameterExperimentScope.TakeProfitOnly}" Content="익절 3개 비교"/>
                    <Button Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Command="{Binding RunCommand}" CommandParameter="{x:Static experiments:ExitParameterExperimentScope.TakeProfitAndStopLoss}" Content="익절·손절 9개 비교"/>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding RunCommand}" CommandParameter="{x:Static experiments:ExitParameterExperimentScope.AllExitParameters}" Content="전체 27개 비교"/>
                </WrapPanel>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.StatusMessage}" Text="{Binding StatusMessage}"/>
                <TextBlock Margin="0,4,0,12" Style="{StaticResource Text.Label}" Text="{Binding ExportPath}" TextWrapping="Wrap"/>
                <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="240">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="익절 ATR" Binding="{Binding Candidate.TakeProfitAtrMultiplier}" Width="*"/>
                        <DataGridTextColumn Header="손절 ATR" Binding="{Binding Candidate.StopLossAtrMultiplier}" Width="*"/>
                        <DataGridTextColumn Header="최대 보유일" Binding="{Binding Candidate.MaxHoldingDays}" Width="*"/>
                        <DataGridTextColumn Header="총수익률" Binding="{Binding PerformanceReport.TotalReturn, StringFormat={}{0:P2}}" Width="*"/>
                        <DataGridTextColumn Header="CAGR" Binding="{Binding PerformanceReport.Cagr, StringFormat={}{0:P2}}" Width="*"/>
                        <DataGridTextColumn Header="MDD" Binding="{Binding EquityCurve.MaxDrawdownRate, StringFormat={}{0:P2}}" Width="*"/>
                        <DataGridTextColumn Header="PF" Binding="{Binding PerformanceReport.ProfitFactor, StringFormat={}{0:N2}}" Width="*"/>
                        <DataGridTextColumn Header="거래 수" Binding="{Binding PerformanceReport.CompletedTrades}" Width="*"/>
                        <DataGridTextColumn Header="오류" Binding="{Binding Error}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
